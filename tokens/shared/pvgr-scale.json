{
  "$description": "Typography and spacing scale maintained by hand. These are Figma styles, not variables, so they are not part of any brand export. They are merged into every brand build. Keep in sync with the design system until Figma exports them as variables.",
  "pvgr": {
    "font-size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "md": { "$type": "dimension", "$value": "1.125rem" },
      "lg": { "$type": "dimension", "$value": "1.25rem" }
    },
    "h1": {
      "font-size": { "$type": "dimension", "$value": "1.875rem" },
      "font-size-mobile": { "$type": "dimension", "$value": "1.25rem" }
    },
    "h2": {
      "font-size": { "$type": "dimension", "$value": "1.25rem" },
      "font-size-mobile": { "$type": "dimension", "$value": "1rem" }
    },
    "h3": {
      "font-size": { "$type": "dimension", "$value": "1rem" },
      "font-size-mobile": { "$type": "dimension", "$value": "0.875rem" }
    },
    "h4": {
      "font-size": { "$type": "dimension", "$value": "0.875rem" },
      "font-size-mobile": { "$type": "dimension", "$value": "0.75rem" }
    },
    "h5": {
      "font-size": { "$type": "dimension", "$value": "0.75rem" },
      "font-size-mobile": { "$type": "dimension", "$value": "0.75rem" }
    },
    "display-1": { "$type": "dimension", "$value": "2.625rem" },
    "display-1-mobile": { "$type": "dimension", "$value": "2.25rem" },
    "display-2": { "$type": "dimension", "$value": "2.25rem" },
    "display-2-mobile": { "$type": "dimension", "$value": "1.875rem" },
    "spacer": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "1rem" },
      "4": { "$type": "dimension", "$value": "1.5rem" },
      "5": { "$type": "dimension", "$value": "2rem" },
      "6": { "$type": "dimension", "$value": "3rem" },
      "7": { "$type": "dimension", "$value": "4.5rem" },
      "8": { "$type": "dimension", "$value": "6rem" },
      "9": { "$type": "dimension", "$value": "7.5rem" },
      "10": { "$type": "dimension", "$value": "10rem" }
    }
  }
}
